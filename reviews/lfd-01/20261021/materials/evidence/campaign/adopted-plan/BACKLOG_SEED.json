  "expansion_templates": [
    {
      "id": "qualification_template",
      "when": "G0/G1 available but a required task-domain lacks G2",
      "creates": [
        "frozen hypothesis and <=6-run initial design",
        "actual controlled comparisons",
        "prospective boundary qualification case",
        "non-author domain decision"
      ],
      "positive_next": "production_template for qualified domain",
      "negative_next": "bounded discriminating followup or fallback_template",
      "final_holdout_credit": false,
      "prospective_boundary_control_required": "至少针对已识别最敏感因素做实际受控比较或独立已知答案；仅新run的G1不构成G2，资格条件不计最终留出"
    },
    {
      "id": "production_template",
      "when": "product gap exists and recipe G2 positive and domain/split/cost bound",
      "batch_conditions": [
        4,
        8
      ],
      "requires": [
        "deduplicate physical condition keys",
        "reserve live tranche",
        "protect final holdout resources",
        "whole event output and all-frame checks"
      ],
      "creates": [
        "real production jobs",
        "data_template",
        "product-state update",
        "next rolling batch or milestone"
      ],
      "parent_done_on_batch_completion": false,
      "bound_recipe_domain_required": true,
      "holdout_gate": "current resource envelope protects outstanding formally unaccepted/uncontaminated gaps; do not require all families frozen"
    },
    {
      "id": "data_template",
      "when": "native full event available or exact existing package reusable",
      "creates": [
        "streaming field/lifecycle checks",
        "uniform reader binding",
        "common endpoint task",
        "sampled history task where qualified",
        "case card and cost"
      ],
      "reuse_unchanged_verified_hashes": true,
      "no_fake_fields": true
    },
    {
      "id": "holdout_template",
      "when": "recipe/region/threshold/domain final frozen",
      "creates": [
        "at_least_6_validation_and_6_test_across_campaign",
        "new generation and planned quality evaluation",
        "no-feedback sealed test scoring"
      ],
      "qualified_boundary_data_are_final_holdout": false,
      "if_design_changes_from_results": "preserve result, move consumed case to development, reserve replacement unseen conditions",
      "release_protection_only_after_formal_uncontaminated_acceptance": true
    },
    {
      "id": "fallback_template",
      "when": "mother/source/hypothesis remains blocked after bounded useful work",
      "creates": [
        "same-family complete alternate or other authorized family",
        "new G0 identity",
        "bounded new source/qualification plan"
      ],
      "keep_old_negative": true,
      "may_rename_to_reset_limits": false,
      "may_contact_others_or_buy_new_resources": false
    },
    {
      "id": "repair_template",
      "when": "specific root cause affects an otherwise useful deliverable",
      "creates": [
        "new-version targeted fix",
        "only risk-relevant regression",
        "actual affected data verification"
      ],
      "same_root_cause_initial_repairs": 2,
      "further_repair_requires": "new root-cause evidence, non-author review, central allocation",
      "retroactive_input_or_cost_rewrite": false
    },
    {
      "id": "gap_replenishment_template",
      "when": "queue low or empty and parent active",
      "creates": [
        "rank remaining product gaps",
        "pick actual next useful action and fallback",
        "bind near-term tasks"
      ],
      "must_check_existing_ready_data_work": true,
      "no_information_tasks_allowed": false,
      "if_no_viable_informative_paths": "S26 then appropriate partial state; no empty spinning"
    }
  ],
  "initial_parallel_workflows": [
    "F1 and numerical scope",
    "data and identity/history tasks",
    "new 3D sources and mothers",
    "product inventory and condition design"
  ],
  "governing_policy": "CAMPAIGN_POLICY.json"
}

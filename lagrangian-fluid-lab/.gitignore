# L2 stores each canary's generated solver assets below a family namespace.
# Keep the large BI4/VTK/XML output local; committed case definitions,
# reports, manifests and hashes remain the review surface.
campaigns/l2-multifamily/*/artifacts/
campaigns/l2-multifamily/*/runs/
campaigns/l2-multifamily/*/data/
# L2-R is a mutable execution ledger; its generated event/artifact files are
# separate from tracked source and the immutable old checkpoint.
campaigns/l2-multifamily/resume-c6b28c8/
# Review bundles are immutable handoff artifacts, not source or experiment state.
review-packages/
release/*/data/
release/*/baselines/checkpoints/
release/*/baselines/logs/
experiments/r5-g4-smoke/*.pt
# Core execution data stays local; compact manifests/reports are versioned.
campaigns/core-v1/runtime/
campaigns/core-v1/cfd/prepared/**/generated/
campaigns/core-v1/cfd/prepared/**/decode*/
campaigns/core-v1/**/*.h5
campaigns/core-v1/**/*.bi4
campaigns/core-v1/**/*.vtk
campaigns/core-v1/**/*.pt
campaigns/core-v1/**/*.npz
# Distributed-slot F2 preflight keeps generated XML/BI4/VTK/log output local;
# its compact Definition, contract, and preflight receipt remain reviewable.
campaigns/core-v1/cfd/f2-distributed-slot-transfer-v1/preflight-v1/generated/
campaigns/core-v1/cfd/f2-distributed-slot-transfer-v1/preflight-v1/gencase.log
# Superseded inline control manifest; compact v2 is the reviewable source.
campaigns/core-v1/f3-dataset.json

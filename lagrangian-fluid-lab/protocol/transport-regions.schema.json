{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lagrangian transport region specification",
  "type": "object",
  "required": ["lifecycle_model", "destination_frame", "destinations"],
  "properties": {
    "lifecycle_model": {"enum": ["closed", "open"]},
    "destination_frame": {
      "oneOf": [
        {"type": "object", "properties": {"kind": {"const": "world"}}, "required": ["kind"]},
        {
          "type": "object",
          "properties": {
            "kind": {"const": "moving_affine"},
            "world_from_frame_dataset": {"type": "string"}
          },
          "required": ["kind", "world_from_frame_dataset"]
        }
      ]
    },
    "sources": {"type": "object"},
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string"},
          "type": {"enum": ["aabb", "halfspace", "sphere"]}
        }
      }
    }
  }
}

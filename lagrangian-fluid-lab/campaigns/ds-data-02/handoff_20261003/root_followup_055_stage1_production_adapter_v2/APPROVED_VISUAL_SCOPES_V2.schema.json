{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ds02.root-approved-visual-scopes.v2",
  "title": "DS-DATA-02 Stage 1 visual-only scope index v2",
  "type": "object",
  "required": ["schema", "campaign_id", "goal_authority", "scopes"],
  "properties": {
    "schema": {"const": "ds02.root-approved-visual-scopes.v2"},
    "campaign_id": {"const": "DS-DATA-02"},
    "goal_authority": {
      "$ref": "#/$defs/fileBinding"
    },
    "interpretation": {"type": "string"},
    "scopes": {
      "type": "array",
      "items": {"$ref": "#/$defs/scope"}
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": true,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "family_id",
        "scope_id",
        "visual_stage_profile",
        "root_visual_domain_decision",
        "physical_domain",
        "case_manifest",
        "visual_evidence"
      ],
      "additionalProperties": true,
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "visual_stage_profile": {"const": "stage1_visual"},
        "goal_authority": {"$ref": "#/$defs/fileBinding"},
        "root_visual_domain_decision": {"$ref": "#/$defs/fileBinding"},
        "physical_domain": {"$ref": "#/$defs/fileBinding"},
        "case_manifest": {"$ref": "#/$defs/fileBinding"},
        "visual_evidence": {"type": "object"}
      }
    }
  }
}

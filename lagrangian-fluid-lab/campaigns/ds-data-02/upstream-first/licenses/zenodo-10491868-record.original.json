{"created": "2024-01-11T16:54:27.531467+00:00", "modified": "2024-01-11T16:54:27.768740+00:00", "id": 10491868, "conceptrecid": "10021925", "doi": "10.5281/zenodo.10491868", "conceptdoi": "10.5281/zenodo.10021925", "doi_url": "https://doi.org/10.5281/zenodo.10491868", "metadata": {"title": "LagrangeBench Datasets", "doi": "10.5281/zenodo.10491868", "publication_date": "2023-06-07", "description": "<p>Datasets from the Paper <a href=\"https://arxiv.org/abs/2309.16342\">LagrangeBench: A Lagrangian Fluid Mechanics Benchmarking Suite</a> at NeurIPS 2023 Track on Datasets and Benchmarks.</p>\n<p>&nbsp;</p>\n<p><strong>Version 2024-01-11 (latest)</strong></p>\n<ul>\n<li>Files with force_fn were added to the three datasets with external forces: 2D_DAM, 2D_RPF, and 3D_RPF. The&nbsp;<a href=\"https://github.com/tumaer/lagrangebench\">LagrangeBench codebase</a> is already compatible with this new force handling.</li>\n<li>Breaking: we added a force function to the dam break dataset. Up until now, this dataset didn't have an external force feature.</li>\n</ul>", "access_right": "open", "creators": [{"name": "Toshev, Artur P.", "affiliation": "Technical University of Munich"}, {"name": "Adams, Nikolaus A.", "affiliation": "Technical University of Munich"}], "related_identifiers": [{"identifier": "arXiv:2309.16342", "relation": "isPartOf", "resource_type": "publication-conferenceproceeding", "scheme": "arxiv"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "meeting": {"title": "Neural Information Processing Systems 2023", "acronym": "NeurIPS 2023", "dates": "11-14 December 2023", "place": "New Orleans, US", "url": "https://neurips.cc/Conferences/2023", "session": "Track on Datasets and Benchmarks"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "10021925"}}]}}, "title": "LagrangeBench Datasets", "links": {"self": "https://zenodo.org/api/records/10491868", "self_html": "https://zenodo.org/records/10491868", "preview_html": "https://zenodo.org/records/10491868?preview=1", "doi": "https://doi.org/10.5281/zenodo.10491868", "self_doi": "https://doi.org/10.5281/zenodo.10491868", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10491868", "reserve_doi": "https://zenodo.org/api/records/10491868/draft/pids/doi", "parent": "https://zenodo.org/api/records/10021925", "parent_html": "https://zenodo.org/records/10021925", "parent_doi": "https://doi.org/10.5281/zenodo.10021925", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10021925", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:10491868/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:10491868/sequence/default", "files": "https://zenodo.org/api/records/10491868/files", "media_files": "https://zenodo.org/api/records/10491868/media-files", "latest": "https://zenodo.org/api/records/10491868/versions/latest", "latest_html": "https://zenodo.org/records/10491868/latest", "versions": "https://zenodo.org/api/records/10491868/versions", "draft": "https://zenodo.org/api/records/10491868/draft", "access_links": "https://zenodo.org/api/records/10491868/access/links", "access_grants": "https://zenodo.org/api/records/10491868/access/grants", "access_users": "https://zenodo.org/api/records/10491868/access/users", "access_request": "https://zenodo.org/api/records/10491868/access/request", "access": "https://zenodo.org/api/records/10491868/access", "communities": "https://zenodo.org/api/records/10491868/communities", "communities-suggestions": "https://zenodo.org/api/records/10491868/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/10491868/request-deletion", "file_modification": "https://zenodo.org/api/records/10491868/file-modification", "quota_increase": "https://zenodo.org/api/records/10491868/quota-increase", "requests": "https://zenodo.org/api/records/10491868/requests"}, "updated": "2024-01-11T16:54:27.768740+00:00", "recid": "10491868
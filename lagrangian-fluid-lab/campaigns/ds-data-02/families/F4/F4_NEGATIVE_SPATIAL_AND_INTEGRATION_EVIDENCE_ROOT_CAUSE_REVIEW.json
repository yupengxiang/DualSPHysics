  "root_causes": {
    "grid_incommensurability": {
      "mechanism": "Column width (0.22m) divided by coarse dp (0.04m) produces non-integer row counts (5.5 particles), causing asymmetric edge rasterization and -3.03% to +2.27% initial mass distortion.",
      "impact": "Artificial initial momentum and potential energy offsets that propagate into collision dynamics."
    },
    "kernel_overlap_precontact": {
      "mechanism": "Wendland smoothing kernel h ~ 1.5 - 2.0 dp creates interaction zones 0.12 - 0.16m wide at coarse resolution, generating repulsive pressure prior to physical boundary touch.",
      "impact": "Pre-contact deceleration delays collision timing by +59.2ms (COL coarse) and +21.8ms (DROP coarse)."
    },
    "splash_sheet_under_resolution": {
      "mechanism": "Vertical splashing sheet thickness delta ~ O(dp) is resolved by only 1-2 particles at dp >= 0.03m, where tensile blunting and numerical shear viscosity prevent high-velocity ejection.",
      "impact": "Extreme spread_z discrepancies (5.08x budget for COL coarse, 4.56x for COL medium) while bulk COM and energy errors remain much smaller."
    },
    "stagnation_point_droplet_bifurcation": {
      "mechanism": "The central collision interface forms a hydrodynamic stagnation line. Droplets near the separatrix undergo chaotic trajectory bifurcation under minute time-step perturbations (sub-millimeter shifts determine whether droplets eject immediately or circulate in the stagnation vortex).",
      "impact": "Large single-droplet chord delays (0.45s - 0.72s) despite tight mass-weighted bulk convergence (22ms - 42ms) and < 3.2% destination disagreement."
    }
  },
  "scientific_decision": {
    "q_n_qualification": "not_granted",
    "production_eligibility": "rejected_for_coarse_and_medium",
    "negative_evidence_role": "Immutable baseline boundary condition; preserves actual physics of 3D splashing and droplet bifurcation.",
    "future_refinement_requirement": "F4 convergence requires dp <= 0.010m (resolving splash sheets with >= 8 particles across thickness) and percentile-based macro envelope metrics."
  }

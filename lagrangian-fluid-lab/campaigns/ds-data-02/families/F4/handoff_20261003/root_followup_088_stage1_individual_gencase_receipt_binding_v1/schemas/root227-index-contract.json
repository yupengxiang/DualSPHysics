{
  "schema": "ds02.f4.root227-index-contract.v1",
  "purpose": "Registered metadata contract consumed by bind_f4_individual_gencase_v1.py",
  "index": {
    "source_commit": "fresh087 source commit prefix, recorded by Root",
    "rows": [
      {
        "case_id": "fresh087 endpoint id",
        "request": "absolute Root-enabled individual GenCase request path",
        "gap_m": "canonical condition value",
        "only_drop_point_z_changed": true,
        "actual_output_prefix": "absolute prepared output prefix"
      }
    ],
    "prior216eight_scientific_failures_preserved": true,
    "oldRoot200eight_solvers_remain_disabled": true,
    "independent_case_increment": 0
  },
  "prepared_report": {
    "schema": "ds02.root.actual-native-source-preflight.v1",
    "source_definition": "must equal canonical owner source_definition.path",
    "definition_sha256": "must equal canonical owner source_definition.sha256",
    "prefix": "must equal index row actual_output_prefix",
    "xml_sha256": "registered producer digest; source may verify XML bytes",
    "bi4_sha256": "registered producer digest; source must not recompute it",
    "generated_xml_particle_counts": {
      "fixed": "actual generated XML count",
      "moving": "actual generated XML count",
      "floating": "actual generated XML count",
      "fluid": "actual generated XML count"
    },
    "actual_total_particles": "actual generated XML total",
    "native_initial_typed_QA": "must remain pending actual arrays"
  },
  "derived_paths": {
    "runtime_receipt": "<actual_output_prefix parent>/execution-receipt.json",
    "generated_xml": "<actual_output_prefix>.xml",
    "generated_bi4": "<actual_output_prefix>.bi4",
    "prepared_input_report": "<actual_output_prefix parent>/prepared-input-report.json"
  },
  "prohibitions": [
    "do not hash or open BI4",
    "do not treat prepared report as native QA",
    "do not promote Root216 negative evidence",
    "do not create an aggregate GenCase receipt",
    "do not add independent-case credit"
  ]
}

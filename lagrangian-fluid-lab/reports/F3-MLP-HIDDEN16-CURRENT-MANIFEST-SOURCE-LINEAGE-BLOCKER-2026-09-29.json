  "contract_analysis": {
    "producer_gap": [
      "The legacy training matrix exposes one untyped manifest_sha256 field while the current producer now distinguishes raw file and canonical payload identity.",
      "The legacy history summaries expose the raw manifest-file SHA and do not carry the current producer's canonical manifest identity.",
      "The legacy fresh-terminal builder receives only the training matrix and history summary; it has no explicit current-manifest identity projection to prove that two differently named hash domains refer to the same payload."
    ],
    "old_receipt_rejection": [
      "The historical training and terminal records use the 20260928 run generation and legacy checkpoint/receipt namespaces.",
      "The current-manifest training producer binds a distinct current run generation and requires config.manifest_sha256 to equal the canonical payload SHA.",
      "Treating the raw history SHA as interchangeable with the matrix canonical SHA would erase the producer-generation boundary and could promote an old receipt as current evidence."
    ],
    "safe_repair_missing": [
      "No immutable legacy receipt or summary may be rewritten to add a hash-domain claim.",
      "No current-manifest training receipt/rollout pair is supplied to this legacy fresh-terminal contract with a typed dual-domain identity and current run binding.",
      "Therefore a normalization or equality relaxation cannot be source-bound and must not be implemented."
    ]
  },
